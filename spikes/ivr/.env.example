# Public base64 Ed25519 verification key; required by all three entry points.
TELNYX_PUBLIC_KEY=
# Secret API credential and fixture Voice API application ID. Required only by
# test_ivr_app/public_app. Edit .env locally; never commit or paste credentials.
TELNYX_API_KEY=
IVR_CONNECTION_ID=
# Synthetic data only, never a real personal identifier.
IVR_SYNTHETIC_ID=000123456
IVR_RESULT_AMOUNT=1425.30
IVR_GATHER_TIMEOUT_MS=20000
IVR_INTER_DIGIT_TIMEOUT_MS=5000
IVR_MAX_ATTEMPTS=2
IVR_SPEECH_GRACE_SECONDS=30
IVR_CALL_TIMEOUT_SECONDS=300
IVR_VOICE=female
# Empty normally. Set 0742 locally for the leading-zero exercise, then remove.
IVR_CHALLENGE_OVERRIDE=
# Client (Lesson 3 automated caller). Independent of fixture IVR_* settings above;
# client code never reads the fixture values. Requires its own Telnyx Voice API
# application ID, a learner-owned outbound caller ID, and the sole test
# destination. Validate outbound profile, number assignment, destination
# permissions, balance, and Telnyx transcription support before calling.
IVR_CLIENT_CONNECTION_ID=
IVR_CLIENT_FROM_NUMBER=
IVR_CLIENT_TO_NUMBER=
# Synthetic data only, never a real personal identifier.
IVR_CLIENT_SYNTHETIC_ID=000123456
IVR_CLIENT_STAGE_TIMEOUT_SECONDS=30
IVR_CLIENT_CALL_TIMEOUT_SECONDS=180
IVR_CLIENT_DTMF_DURATION_MS=250
IVR_CLIENT_DTMF_PAUSE_UNITS=0

# Cloud diagnostic deployment uses inbound; preserve the local default.
IVR_CLIENT_TRANSCRIPTION_TRACK=inbound
